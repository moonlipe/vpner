# Copie para vpn-daemon.env (fora do repo) e preencha com os valores reais.
# Passe pro container via: podman run --env-file vpn-daemon.env ...

VPN_GATEWAY=vpn.clienteA.com.br
VPN_USERNAME=seu.usuario@empresa.com
VPN_PASSWORD=sua_senha_aqui

# Opcionais (valores padrão já são adequados pra produção em container)
VPN_HEADLESS=1
VPN_DEBUG=0
VPN_SCREENSHOTS=0
